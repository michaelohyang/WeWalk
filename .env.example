# Copy to .env.local for local development. Never commit real values.

# Supabase Postgres, transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=
# Supabase Postgres, direct connection (port 5432). Used only by migrations.
DIRECT_URL=
# Invite code embedded in the crew's join link (/j/<code>). Rotate to stop new joins.
CREW_CODE=

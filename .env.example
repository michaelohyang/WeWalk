# Copy to .env.local for local development. Never commit real values.

# Supabase Postgres, transaction pooler (port 6543). Used by the app at runtime.
# Or, locally: pglite:.data/dev (embedded Postgres) or pglite:memory.
DATABASE_URL=
# Supabase Postgres, direct connection (port 5432). Used only by migrations.
DIRECT_URL=
# Invite code embedded in the crew's join link (/j/<code>). At least 16 characters, e.g.
# `openssl rand -hex 16`. Rotate it to stop new joins; existing phones stay signed in.
CREW_CODE=

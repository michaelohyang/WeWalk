# Copy to .env.local for local development. Never commit real values.

# Supabase Postgres, transaction pooler (port 6543). Used by the app at runtime.
# Or, locally: pglite:.data/dev (embedded Postgres) or pglite:memory.
DATABASE_URL=
# Supabase Postgres, session pooler (port 5432). Used only by migrations (pnpm db:deploy).
DIRECT_URL=
# Vercel Blob, for review photos. Vercel adds this when a Blob store is connected to the project.
# Leave it empty locally: photos are kept in memory (they disappear on restart).
BLOB_READ_WRITE_TOKEN=
